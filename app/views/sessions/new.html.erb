<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      
      <div class="card shadow-sm border-0">
        <div class="card-header bg-black text-white text-center py-3">
          <h4 class="mb-0">Staff Sign In</h4>
        </div>
        
        <div class="card-body p-4">
          <% if alert = flash[:alert] %>
            <div class="alert alert-danger text-center"><%= alert %></div>
          <% end %>

          <%= form_with url: session_path, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :email_address, class: "form-label fw-bold" %>
              <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "name@wheelhouse.com", value: params[:email_address], class: "form-control" %>
            </div>

            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <%= form.label :password, class: "form-label fw-bold mb-0" %>
                <%= link_to "Forgot password?", new_password_path, class: "text-decoration-none text-dark small" %>
              </div>
              <%= form.password_field :password, required: true, autocomplete: "current-password", class: "form-control" %>
            </div>

            <div class="d-grid mt-4">
              <%= form.submit "Sign in", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>
        </div>
        
        <div class="card-footer bg-light text-center py-3 border-0">
          <span class="text-dark">Are you a new staff member?</span>
          <%= link_to "Sign up here", new_registration_path, class: "fw-bold text-decoration-underline text-dark ms-1" %>
        </div>
      </div>
      
    </div>
  </div>
</div>

