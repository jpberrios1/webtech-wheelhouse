<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white text-center py-3">
          <h4 class="mb-0">Forgot Password</h4>
        </div>
        
        <div class="card-body p-4">
          <% if alert = flash[:alert] %>
            <div class="alert alert-danger text-center"><%= alert %></div>
          <% end %>
          
          <p class="text-muted mb-4">Enter your email address and we will send you a password reset link.</p>

          <%= form_with url: passwords_path, local: true do |form| %>
            <div class="mb-4">
              <%= form.label :email_address, class: "form-label fw-bold" %>
              <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "form-control" %>
            </div>

            <div class="d-grid">
              <%= form.submit "Email reset link", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>
        </div>
        
        <div class="card-footer bg-secondary-subtle text-center py-3 border-0">
          <%= link_to "Back to Sign in", new_session_path, class: "fw-bold text-primary text-decoration-none text-dark" %>
        </div>
      </div>
    </div>
  </div>
</div>