<div class="px-4 py-5 my-5 text-center">
  <h1 class="display-4 fw-bold text-body-emphasis mb-3">Welcome to Wheelhouse</h1>
  <div class="col-lg-6 mx-auto">
    <p class="lead mb-4">Your trusted neighborhood mechanics. We offer transparent pricing and expert service so you can get back on the road safely and swiftly.</p>
    <% unless authenticated? %>
      <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
        <%= link_to "View Wall Price List", standard_services_path, class: "btn btn-primary btn-lg px-4 gap-3" %>
      </div>
    <% end %>
  </div>
</div>

<div class="container px-4 py-5" id="custom-cards">
  <h2 class="pb-2 border-bottom">Most Popular Services</h2>
  <div class="row row-cols-1 row-cols-lg-3 align-items-stretch g-4 py-4">
    <!-- Card 1 -->
    <div class="col">
      <div class="card card-cover h-100 p-4 text-bg-dark rounded-4 shadow-lg" style="background-color: #2b3035;">
        <h3 class="mb-4 display-6 lh-1 fw-bold text-white">Basic Tune-up</h3>
        <p class="text-light opacity-75">Brake adjustments, gear indexing, and chain lubrication to keep your daily commute smooth.</p>
      </div>
    </div>
    <!-- Card 2 -->
    <div class="col">
      <div class="card card-cover h-100 p-4 text-bg-dark rounded-4 shadow-lg" style="background-color: #343a40;">
        <h3 class="mb-4 display-6 lh-1 fw-bold text-white">Flat Tire Repair</h3>
        <p class="text-light opacity-75">Quick tube replacement and wheel inspection. Get back riding in less than 20 minutes.</p>
      </div>
    </div>
    <!-- Card 3 -->
    <div class="col">
      <div class="card card-cover h-100 p-4 text-bg-dark rounded-4 shadow-lg" style="background-color: #495057;">
        <h3 class="mb-4 display-6 lh-1 fw-bold text-white">Full Overhaul</h3>
        <p class="text-light opacity-75">Complete disassembly, deep cleaning, and re-greasing of all bearings and components.</p>
      </div>
    </div>
  </div>
</div>