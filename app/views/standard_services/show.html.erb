<div class="container mt-4">
    <h1 class="text-center fw-semibold fs-2"> Service Information </h1>

    <div class="card shadow p-3 mb-2 bg-body-tertiary rounded mt-5">
        <div class="card-body">
            <h3 class="card-title"> <%= @standard_service.name%> </h3>
            <hr>
            <p class="card-text">
                <strong>Current Price:</strong>
                <%= number_to_currency(@standard_service.current_price) %>
            </p>
        </div>
    </div>

    <div class="d-flex gap-2">
        <%= link_to "Edit", edit_standard_service_path(@standard_service), class: "btn btn-light" %>
        <%= button_to "Delete", standard_service_path(@standard_service), method: :delete, data: { turbo_confirm: "Are you sure you want to delete #{@standard_service.name}?" }, class: "btn btn-danger" %>
    </div>


    <div class="mt-4">
        <%= link_to "Back to Services", standard_services_path, class: "btn btn-outline-secondary" %>
    </div>
</div>