<div class="container-fluid mt-4">


    <div class="justify-content-between align-items-center mb-4 me-3">
        <h1 class="fw-semibold fs-2">Services</h1>
        <%= link_to "New Service", new_standard_service_path, class: "btn btn-success float-end" %>
    </div>


    <% if @standard_services.empty? %>
        <div class="alert alert-info">
            There are currently no services available.
        </div>
    <% else %>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Current Price</th>
            </tr>
        </thead>

        <tbody>
            <% @standard_services.each do |service| %>
                <tr>
                    <td> <%= service.name %> </td>
                    <td> <%= number_to_currency(service.current_price) %> </td>
                    <td>
                        <%= link_to "See More", standard_service_path(service), class: "btn btn-sm btn-primary" %>
                    </td>
                </tr>
            <% end %>
        </tbody>
    </table>
    <% end %>
</div>