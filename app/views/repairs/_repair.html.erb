<% is_late = repair.overdue? %>
<tr class="<%= 'table-danger' if is_late %> align-middle">
    <!-- Thumbnail de la Foto -->
    <td>
        <% if repair.intake_photos.attached? %>
            <%= image_tag repair.intake_photos.first.variant(:thumb), class: "img-thumbnail border-0", style: "width: 60px; height: 60px; object-fit: cover;",
             alt: "#{repair.bike.bike_model.name} - #{repair.bike.serial_number} intake photo" %>
        <% else %>
            <div style="width: 60px; height: 60px; display: inline-block;" class="bg-light border rounded"></div>
        <% end %>
    </td>

    <td>
        <% if repair.diagnosis.present? %>
            <span class="text-truncate d-inline-block" style="max-width: 150px;">
                <%= truncate(repair.diagnosis.to_plain_text, length: 40) %>
            </span>
        <% else %>
            <span class="text-muted">-</span>
        <% end %>
    </td>

    <td> <%= repair.bike.customer.name %> </td>
    <td> <%= repair.bike.bike_model.name%> </td> 

    <td>
        <% if repair.mechanic.present? %>
            <%= repair.mechanic.name %>
        <% else %>
            <span class="text-muted"> Unassigned </span>
        <% end %>
    </td>

    <td>
        <% if repair.received?%>
            <span class="badge bg-secondary-subtle text-dark">Received</span>
        <!-- ... (mantén el resto de tus validaciones de estado igual que antes) ... -->
        <% else %>
            <%= repair.state.titleize %>
        <% end %>
    </td>
    <td> <%= repair.promised_on %> </td>

    <td>
        <%= link_to "Show Details", repair_path(repair), class: "btn btn-sm btn-primary" %>
    </td>
</tr>