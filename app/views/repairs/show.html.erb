<div class="container mt-4">
    <h1 class="text-center fw-semibold fs-2"> Repair Detail </h1>

    <div class="card shadow p-3 mb-3 bg-body-tertiary rounded mt-5">
        <div class="card-body">
            <h4 class="card-title"> <%= link_to "#{@repair.bike.bike_model.name} (#{@repair.bike.serial_number})", bike_path(@repair.bike), class: "link-dark link-offset-2 link-underline-opacity-0 link-underline-opacity-100-hover" %>
            </h4>

            <h6 class= "card-subtitle mb-2 text-muted">Customer: <%= link_to @repair.bike.customer.name, customer_path(@repair.bike.customer), class: "link-secondary link-offset-2 link-underline-opacity-0 link-underline-opacity-100-hover" %>
            </h6>
            <hr>
            <div class= "row"> 
                <div class= "col-md-6"> 
                    <p> <strong>Assigned Mechanic:</strong>  <%= @repair.mechanic.present? ? @repair.mechanic.name : "Unassigned" %></p>
                    <p> <strong>Status:</strong> <%= @repair.state.titleize %>  </p>
                </div>
                <div class= "col-md-6">
                    <p> <strong>Promised Date:</strong> <%= @repair.promised_on || "Undefined" %> </p>
                    <p> <strong>Delivery Date:</strong> <%= @repair.handed_back_at || "Pending" %> </p>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <%= link_to "Edit", edit_repair_path(@repair), class: "btn btn-light" %>
        <%= button_to "Delete", repair_path(@repair), method: :delete, data: { turbo_confirm: "Are you sure you want to delete the repair for #{@repair.bike.serial_number}?" }, class: "btn btn-danger" %>
    </div>

    <h4 class="mt-4 fw-semibold fs-3">Diagnosis</h4>
    <% if @repair.diagnosis.present? %>
      <div class="card shadow-sm p-3 mb-4 bg-white rounded">
        <%= @repair.diagnosis %>
      </div>
    <% else %>
      <div class="alert alert-secondary mt-3">This repair has no diagnosis.</div>
    <% end %>

    <h4 class="mt-4 fw-semibold fs-3">Intake Photos</h4>
    <% if @repair.intake_photos.attached? %>
      <div class="d-flex flex-wrap gap-3 mt-3 mb-4">
        <% @repair.intake_photos.each do |photo| %>
          <%= link_to photo, target: "_blank" do %>
            <%= image_tag photo.variant(:large), class: "img-thumbnail shadow-sm", alt: "#{@repair.bike.bike_model.name} - #{@repair.bike.serial_number} intake photo" %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="alert alert-secondary mt-3 mb-4">This repair has no intake photos.</div>
    <% end %>

    <h4 class= "mt-4 fw-semibold fs-3">Services Charged for This Repair</h4>
    <% if @repair.repair_services.empty? %>
        <div class= "alert alert-warning mt-3">No services have been added to this repair yet</div>
    <% else %>
        <table class= "table table-bordered mt-3"> 
            <thead class = "table-light"> 
                <tr>
                    <th>Service</th>
                    <th>Charged Price</th>
                </tr>
            </thead>
            <tbody>
                <% @repair.repair_services.each do |rs| %>
                    <tr>
                        <td> <%= rs.standard_service.name %> </td>
                        <td> <%= number_to_currency(rs.charged_price) %> </td>
                    </tr>
                <% end %>
            </tbody>
            <tfoot class= "table-group-divider">
                <tr>
                    <th>Total</th>
                    <th> <%= number_to_currency(@repair.total) %> </th>
                </tr>
            </tfoot>
        </table>
    <% end %>

    <div class="mt-3 mb-3">
        <%= link_to "Back to Repairs", repairs_path, class: "btn btn-outline-secondary" %>
    </div>
</div>