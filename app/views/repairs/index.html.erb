<div class="cointainer mt-4">
    <% if @repairs.empty? %>
        <div class="alert alert-info">
            No repairs have been registered yet
        </div>
    <% else %>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Bicycle</th>
                <th>Mechanic</th>
                <th>Status</th>
                <th>Promised Date</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            <% @repairs.each do |repair| %>
                <% is_late = repair.promised_on.present? && repair.promised_on < Date.current && repair.handed_back_at.nil? %>
                    <tr class="<%= 'table-danger' if is_late %>">
                        <td> <%= repair.bike.customer.name %> </td>
                        <td> <%= repair.bike.bike_model.name%> </td> 

                        <td>
                            <% if repair.mechanic.present? %>
                                <%= repair.mechanic.name %>
                            <% else %>
                                <span class="text-muted"> Unassigned </span>
                            <% end %>
                        </td>

                        <td>
                            <% case repair.state %>
                            <% when 'received' %>
                                <span class="badge bg-secondary-subtle text-dark">Received</span>
                            <% when 'quoted' %>
                                <span class="badge bg-dark_subtle text-dark">Quoted</span>
                            <% when 'approved' %>
                                <span class="badge bg-info-subtle text-dark">Approved</span>
                            <% when 'declined' %>
                                <span class="badge bg-danger text-dark">Declined</span>
                            <% when 'in_progress' %>
                                <span class="badge bg-warning text-dark">In Progress</span>
                            <% when 'ready' %>
                                <span class="badge bg-success">Ready</span>
                            <% when 'handed_back' %>
                                <span class="badge bg-success-subtle text-dark">Handed Back</span>
                            <% else %>
                                <%= repair.state.titleize %>
                            <% end %>
                        </td>
                        <td> <%= repair.promised_on %> </td>

                        <td>
                            <%= link_to "Show Details", repair_path(repair), class: "btn btn-sm btn-primary" %>
                        </td>
                    </tr>
                <% end %>
            </tbody>
        </table>
    <% end %>
</div>