<div class="cointainer mt-4">

    <div class="justify-content-between align-items-center mb-4 me-3">
        <h1 class="fw-semibold fs-2 ms-2">Repairs</h1>
        <%= link_to "New Repair", new_repair_path, class: "btn btn-success float-end" %>
    </div>

    <% if @repairs.empty? %>
        <div class="alert alert-info">
            No repairs have been registered yet
        </div>
    <% else %>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Bicycle</th>
                <th>Mechanic</th>
                <th>Status</th>
                <th>Promised Date</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
           <%= render @repairs %>
        </tbody>
    </table>
    <% end %>
</div>