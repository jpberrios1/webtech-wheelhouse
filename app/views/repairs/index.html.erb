<div class="cointainer mt-4">
    <% if @repairs.empty? %>
        <div class="alert alert-info">
            No repairs have been registered yet
        </div>
    <% else %>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Bicycle</th>
                <th>Mechanic</th>
                <th>Status</th>
                <th>Promised Date</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
           <%= render @repairs %>
        </tbody>
    </table>
    <% end %>
</div>