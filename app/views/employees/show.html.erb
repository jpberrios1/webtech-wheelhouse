<div class="container mt-4">
    <h1 class="text-center fw-semibold fs-2"> Employee Profile </h1>

    <div class="card shadow p-3 mb-3 bg-body-tertiary rounded mt-5">
        <div class="card-body">
            <h3 class="card-title"> <%= @employee.name%> </h3>
            <hr>
            <p class="card-text">
                <strong>Role:</strong> <%= @employee.role %>
            </p>
        </div>
    </div>

     <div class="d-flex gap-2">
        <%= link_to "Edit", edit_employee_path(@employee), class: "btn btn-light" %>
        <%= button_to "Delete", employee_path(@employee), method: :delete, data: { turbo_confirm: "Are you sure you want to delete #{@employee.name}?" }, class: "btn btn-danger" %>
    </div>

    <div class="mt-5">
        <%= link_to "Back to Employees", employees_path, class: "btn btn-outline-secondary" %>
    </div>
</div>