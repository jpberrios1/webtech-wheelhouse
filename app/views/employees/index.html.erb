<div class="container-fluid mt-4">
    
    <div class="justify-content-between align-items-center mb-4 me-3">
        <h1 class="fw-semibold fs-2">Employees</h1>
        <%= link_to "New Employee", new_employee_path, class: "btn btn-success float-end" %>
    </div>

    <% if @employees.empty? %>
        <div class="alert alert-info">
            There are no employees registered at the moment.
        </div>
    <% else %>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Role</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            <% @employees.each do |employee| %>
                <tr>
                    <td> <%= employee.name %> </td>
                    <td> <%= employee.role %> </td>
                    <td>
                        <%= link_to "See More", employee_path(employee), class: "btn btn-sm btn-primary" %>
                    </td>
                </tr>
            <% end %>
        </tbody>
    </table>
    <% end %>
</div>