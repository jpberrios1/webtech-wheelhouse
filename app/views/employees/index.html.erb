<div class="cointainer mt-4">
    <% if @employees.empty? %>
        <div class="alert alert-info">
            There are no employees registered at the moment.
        </div>
    <% else %>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Role</th>
            </tr>
        </thead>

        <tbody>
            <% @employees.each do |employee| %>
                <tr>
                    <td> <%= employee.name %> </td>
                    <td> <%= employee.role %> </td>
                    <td>
                        <%= link_to "See More", employee_path(employee), class: "btn btn-sm btn-primary" %>
                    </td>
                </tr>
            <% end %>
        </tbody>
    </table>
    <% end %>
</div>