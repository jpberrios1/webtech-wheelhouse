<div class="container mt-4">
    <h1 class="text-center fw-semibold fs-2"> Customer Details </h1>

    <div class="card shadow p-3 mb-5 bg-body-tertiary rounded mt-5">
        <div class="card-body">
            <h3 class="card-title"> <%= @customer.name%> </h3>
            <hr>
            <p class="card-text">
                <strong>Phone:</strong> <%= @customer.phone %>
            </p>

            <p class="card-text">
                <strong> Customer Status </strong>
                <% if @customer.is_regular %>
                    <span class="badge rounded-pill text-bg-success"> Regular </span>
                <% else %>
                    <span class= "badge rounded-pill text-bg-secondary"> Non Regular </span>
                <% end %>
            </p>
        </div>
    </div>


    <div class="container">
        <h3 class="fw-semibold fs-3">Registered Bicycles</h3>
        <% if @customer.bikes.empty? %>
            <p class="text-muted">This customer doesn't have any registered bicycles yet</p> 
        <% else %>
            <table class="table table-striped mt-3">
               <thead>
                    <tr>
                        <th>Serial Number</th>
                        <th>Model</th>
                        <th>Owner</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <%= render @customer.bikes %>
                </tbody>
            </table> 
        <% end %>
    </div>

    <div class="mt-3">
        <%= link_to "Back to Customers", customers_path, class: "btn btn-outline-secondary" %>
    </div>
</div>