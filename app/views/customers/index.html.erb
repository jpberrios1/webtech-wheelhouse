<div class="cointainer mt-4">
    <% if @customers.empty? %>
        <div class="alert alert-info">
            No customers have been registered yet
        </div>
    <% else %>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Regular</th>
            </tr>
        </thead>

        <tbody>
            <% @customers.each do |customer| %>
                <tr>
                    <td> <%= customer.name %> </td>
                    <td> <%= customer.phone %> </td>
                    <td> <%= customer.is_regular ? "Regular" : "Not Regular" %> </td>
                    <td>
                        <%= link_to "See More", customer_path(customer), class: "btn btn-sm btn-primary" %>
                    </td>
                </tr>
            <% end %>
        </tbody>
    </table>
    <% end %>
</div>