<div class="col-md-6 mx-auto mt-5">
  <div class="card shadow">
    <div class="card-header bg-primary text-white">
      <h2 class="h5 mb-0">Staff Sign Up</h2>
    </div>
    <div class="card-body p-4">
      <%= form_with model: @user, url: registration_path, local: true do |form| %>
        
        <% if @user.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= form.label :email_address, class: "form-label fw-bold" %>
          <!-- REQUISITO 5: El email mantiene su valor si hay error -->
          <%= form.email_field :email_address, class: "form-control", required: true, value: @user.email_address %>
        </div>

        <div class="mb-3">
          <%= form.label :password, class: "form-label fw-bold" %>
          <%= form.password_field :password, class: "form-control", required: true, minlength: 10 %>
          <div class="form-text">Minimum 10 characters.</div>
        </div>

        <div class="mb-4">
          <%= form.label :password_confirmation, class: "form-label fw-bold" %>
          <%= form.password_field :password_confirmation, class: "form-control", required: true %>
        </div>

        <div class="d-grid">
          <%= form.submit "Create Account", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>