<div class="container mt-4">
    <h1 class="text-center fw-semibold fs-2"> Bike Details </h1>

    <div class="card shadow p-3 mb-3 bg-body-tertiary rounded mt-5">
        <div class="card-body">
            <h3 class="card-title"><%= @bike.bike_model.name%> </h3>
            <hr>
            <p class="card-text">
                <strong>Serial No.:</strong> <%= @bike.serial_number %>
            </p>

            <p class="card-text">
                <strong>Owner</strong> <%= link_to @bike.customer.name, customer_path(@bike.customer), class: "text-decoration-none" %>
            </p>
        </div>
    </div>

    <div class="d-flex gap-2">
        <%= link_to "Edit", edit_bike_path(@bike), class: "btn btn-light" %>
        <%= button_to "Delete", bike_path(@bike), method: :delete, data: { turbo_confirm: "Are you sure you want to delete #{@bike.serial_number}?" }, class: "btn btn-danger" %>
        <%= link_to "New Repair for this Bike", new_repair_path(bike_id: @bike.id), class: "btn btn-success" %>
    </div>


<div class="container mt-5">
        <h3 class="fw-semibold fs-3">Repairs Performed on this Bike</h3>
        <% if @bike.repairs.empty? %>
            <p class="text-muted">No repairs have been done yet</p> 
        <% else %>
            <table class="table table-striped mt-3">
                <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Diagnosis</th>
                        <th>Customer</th>
                        <th>Bicycle</th>
                        <th>Mechanic</th>
                        <th>Status</th>
                        <th>Promised Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <%= render @bike.repairs.newest_first %>
                </tbody>
            </table>
        <% end %>
    </div>


    <div class="mt-3">
        <%= link_to "Back to Bikes", bikes_path, class: "btn btn-outline-secondary" %>
    </div>
</div>