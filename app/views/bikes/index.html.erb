<div class="cointainer mt-4">
    
    <div class="justify-content-between align-items-center mb-4 me-3">
        <h1 class="fw-semibold fs-2 ms-1">Bikes</h1>
        <%= link_to "New Bike", new_bike_path, class: "btn btn-success float-end" %>
    </div>

    <% if @bikes.empty? %>
        <div class="alert alert-info">
            No bicycles have been registered yet
        </div>
    <% else %>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Serial Number</th>
                <th>Model</th>
                <th>Owner</th>
            </tr>
        </thead>

        <tbody>
            <%= render @bikes %>
        </tbody>
    </table>
    <% end %>
</div>