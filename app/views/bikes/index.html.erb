<div class="cointainer mt-4">
    <% if @bikes.empty? %>
        <div class="alert alert-info">
            No bicycles have been registered yet
        </div>
    <% else %>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Serial Number</th>
                <th>Model</th>
                <th>Owner</th>
            </tr>
        </thead>

        <tbody>
            <%= render @bikes %>
        </tbody>
    </table>
    <% end %>
</div>